# per-app virtualenvs / build caches
**/.venv/
**/__pycache__/
*.pyc
**/.pytest_cache/
**/*.egg-info/
apps/model-backend/output/thesis_final/   # regenerable: build_thesis_artifacts.py -> package_thesis_evidence.py -> evidence/
apps/model-backend/Results/     # scripts/evaluation.py scratch output
apps/model-backend/logs/
apps/console/frontend/node_modules/
apps/console/frontend/.vite/
.DS_Store
# built frontend bundle is committed (apps/console/web-dist) so the demo runs without pnpm
